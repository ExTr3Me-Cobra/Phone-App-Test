<?xml version="1.0" encoding="utf-8"?>
<!-- Only draws the edge lighting: reads no screen content and performs no gestures. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAnnouncement"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/light_description"
    android:notificationTimeout="1000"
    android:summary="@string/light_summary" />
